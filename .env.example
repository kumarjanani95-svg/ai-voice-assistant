PORT=3000
NODE_ENV=development

# groq (default, free) | gemini (free) | ollama (local, free) | openai | fallback
LLM_PROVIDER=groq

# Free Groq key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo

# Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash

# Local models: install Ollama, then `ollama pull llama3.2`
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2

# Paid OpenAI is optional and unused unless LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

SESSION_TTL_MS=1800000
MEMORY_MESSAGE_LIMIT=24
MAX_AUDIO_BYTES=10485760

# Pickup/destination geocoding for conversation (not Google, not MySQL)
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODER_COUNTRY_CODES=
GEOCODER_USER_AGENT=OTOVOICE/1.0 (conversation-layer)
